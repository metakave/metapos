{
  "name": "metapos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=src/data server/index.ts",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "start": "node server/index.ts --production",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "seed": "node server/seed.ts",
    "seed:clear": "node server/seed.ts --clear"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
